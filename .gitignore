/node_modules
/.next
/out
/build
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Phase 16A — local document object-storage provider's filesystem root
/.data

# Env files — .example files are safe to commit (no secrets)
.env
.env.local
.env.*.local
.env.production
.env.development

# Production backups — never commit DB dumps
/backups/
scripts/backups/
*.sql
*.sql.gz
# Prisma migration files must be committed so deployments can run migrate deploy
!prisma/migrations/**/*.sql
# Reviewed read-only diagnostic queries — never dumps, and no data of any kind
!scripts/security/*.sql

# SSL certificates — managed by Certbot on the VPS
deploy/ssl/certs/
/etc/letsencrypt/
.env.production

# Phase 98 — generated offline assurance artifact (produced by npm run eval:phase98,
# uploaded by CI as a build artifact; not source).
/phase98-assurance.json

# Phase 99 — generated evaluator outputs (npm run eval:phase99:readiness /
# :closure), uploaded by CI as build artifacts. The COMMITTED Phase 99 artifacts
# are the route inventory, the finding register and the dependency review under
# docs/security/ — these two are run results, not source.
/phase99-readiness.json
/phase99-closure.json

# Phase 100 — the canonical GA closure verdict (npm run eval:phase100:closure),
# uploaded by CI as a build artifact. It is a RUN RESULT, deliberately not
# committed: a checked-in verdict is a verdict that goes stale, which is exactly
# how docs/release/go-no-go-matrix.md came to assert V1_RELEASE_READY: YES.
/phase100-ga-closure.json

# Phase 107 visual-evidence harness output.
# The harness refuses to write inside the source tree (see
# tools/audit/visual-evidence/README.md); this is the belt to that braces, kept
# scoped to the harness output directory ONLY. A repo-wide `**/_records/` or
# `*.visual-sweep.lock` would silently hide legitimately-named source anywhere
# in the tree — a worse failure than an un-ignored artefact.
/hermes-evidence/
/hermes-evidence/_records/
/hermes-evidence/.visual-sweep.lock
