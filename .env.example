# Hermes OS — Example Environment Configuration
#
# SECURITY: This file is COMMITTED to Git and documents variable NAMES and
# SAFE, non-functional example values ONLY. It must never contain a real
# secret, credential, production hostname/IP or personal data.
#
# Copy this file to `.env` (which is git-ignored) and replace every
# REPLACE_WITH_* placeholder before running the application. The static gate
# `scripts/security/check-env-example.mjs` (npm run security:check-env) fails
# if a secret-like value is ever committed here.

# -- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Storage mode ------------------------------------------------------------
# "database" uses PostgreSQL; "session" runs against an in-process store.
HERMES_STORAGE_MODE=database

# -- Database ----------------------------------------------------------------
# Local development connection string -- replace the password before use.
DATABASE_URL=postgresql://hermes:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/hermes_example
POSTGRES_USER=hermes
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
POSTGRES_DB=hermes_example

# -- Redis -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Authentication secrets --------------------------------------------------
# Generate independent random values (e.g. openssl rand -base64 48).
# The two secrets MUST differ from each other.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_BEFORE_USE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_BEFORE_USE

# -- Email -------------------------------------------------------------------
# "console" prints emails to stdout in development; no credentials required.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com

# -- AI providers (optional; disabled by default) ----------------------------
# Leave empty to keep external AI providers OFF. Never commit a real key.
ANTHROPIC_API_KEY=

# -- Feature flags -----------------------------------------------------------
HERMES_RAG_MODE=off
HERMES_PROJECT_INTELLIGENCE_ENABLED=false
